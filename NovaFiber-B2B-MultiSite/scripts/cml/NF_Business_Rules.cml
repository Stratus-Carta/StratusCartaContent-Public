// NF_Business_Rules: generated by scripts/cml/nf_cml.py from NF_Business_Rules.json. Edit the spec, not this file.
// One relation per component group; rules come from the spec.

type LineItem;

// NFB-DIA-100
type NFBDia100 : LineItem {
    relation equipment : NFGroup_equipment[0..1];
    relation installation : NFGroup_installation[0..1];
    relation ipAddresses : NFGroup_ipAddresses[0..2];
    relation resilienceSecurity : NFGroup_resilienceSecurity[0..3];
    exclude(ipAddresses[NFBIpBlock28] > 0, ipAddresses[NFBIpBlock29], "The /28 block replaces the /29 block: a site takes one static IP block.");
}

// NFB-DIA-1G
type NFBDia1G : LineItem {
    relation equipment : NFGroup_equipment[0..1];
    relation installation : NFGroup_installation[0..1];
    relation ipAddresses : NFGroup_ipAddresses[0..2];
    relation resilienceSecurity : NFGroup_resilienceSecurity[0..3];
    exclude(ipAddresses[NFBIpBlock28] > 0, ipAddresses[NFBIpBlock29], "The /28 block replaces the /29 block: a site takes one static IP block.");
}

// NFB-DIA-10G
type NFBDia10G : LineItem {
    relation equipment : NFGroup_equipment[0..1];
    relation installation : NFGroup_installation[0..1];
    relation ipAddresses : NFGroup_ipAddresses[0..2];
    relation resilienceSecurity : NFGroup_resilienceSecurity[0..3];
    exclude(ipAddresses[NFBIpBlock28] > 0, ipAddresses[NFBIpBlock29], "The /28 block replaces the /29 block: a site takes one static IP block.");
    require(true, resilienceSecurity[NFBDiversePath], "10 Gbps Dedicated Internet is built on two diverse fiber paths.");
    require(true, resilienceSecurity[NFBDdos], "10 Gbps Dedicated Internet includes DDoS protection.");
    message(resilienceSecurity[NFBDiversePath] > 0 && resilienceSecurity[NFBDdos] > 0, "10 Gbps Dedicated Internet includes Diverse Path and DDoS Protection.", "Info");
}

// NFB-VOC-UC
type NFBVoiceUC : LineItem {
    relation addons : NFGroup_addons[0..12];
    relation devices : NFGroup_devices[0..250];
    relation seats : NFGroup_seats[0..250];
    constraint(devices[NFBDeskPhone] <= seats[NFBUcSeat], "Each IP desk phone needs a UC seat: add seats or remove phones.");
}

type NFGroup_equipment : LineItem {}
type NF_NFB_EQ_MRTR : NFGroup_equipment {}   // NFB-EQ-MRTR
type NFGroup_installation : LineItem {}
type NF_NFB_INS_DIA : NFGroup_installation {}   // NFB-INS-DIA
type NFGroup_ipAddresses : LineItem {}
type NFBIpBlock28 : NFGroup_ipAddresses {}   // NFB-ADD-IP16
type NFBIpBlock29 : NFGroup_ipAddresses {}   // NFB-ADD-IP8
type NFGroup_resilienceSecurity : LineItem {}
type NF_NFB_ADD_BKP : NFGroup_resilienceSecurity {}   // NFB-ADD-BKP
type NFBDdos : NFGroup_resilienceSecurity {}   // NFB-ADD-DDOS
type NFBDiversePath : NFGroup_resilienceSecurity {}   // NFB-ADD-DIV
type NFGroup_addons : LineItem {}
type NF_NFB_ADD_AA : NFGroup_addons {}   // NFB-ADD-AA
type NF_NFB_ADD_DID : NFGroup_addons {}   // NFB-ADD-DID
type NF_NFB_ADD_REC : NFGroup_addons {}   // NFB-ADD-REC
type NFGroup_devices : LineItem {}
type NFBDeskPhone : NFGroup_devices {}   // NFB-EQ-PHONE
type NFGroup_seats : LineItem {}
type NFBUcSeat : NFGroup_seats {}   // NFB-VOC-SEAT
