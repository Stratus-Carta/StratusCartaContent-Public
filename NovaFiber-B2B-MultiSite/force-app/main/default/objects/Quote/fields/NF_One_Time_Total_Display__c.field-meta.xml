<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NF_One_Time_Total_Display__c</fullName>
    <label>NF One-time Total (display)</label>
    <description>One-time total as text for document templates.</description>
    <formula>"$" &amp; IF((BLANKVALUE(NF_One_Time_Total__c, 0)) &gt;= 1000, TEXT(FLOOR((BLANKVALUE(NF_One_Time_Total__c, 0)) / 1000)) &amp; "," &amp; RIGHT("00" &amp; TEXT(MOD(FLOOR((BLANKVALUE(NF_One_Time_Total__c, 0))), 1000)), 3), TEXT(FLOOR((BLANKVALUE(NF_One_Time_Total__c, 0))))) &amp; "." &amp; RIGHT("0" &amp; TEXT(ROUND(MOD((BLANKVALUE(NF_One_Time_Total__c, 0)), 1) * 100, 0)), 2)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
