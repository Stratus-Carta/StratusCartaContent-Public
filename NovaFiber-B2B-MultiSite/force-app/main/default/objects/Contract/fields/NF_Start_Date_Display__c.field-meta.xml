<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NF_Start_Date_Display__c</fullName>
    <label>NF Start Date (display)</label>
    <description>Contract start date, written out.</description>
    <formula>CASE(MONTH(StartDate), 1, "January", 2, "February", 3, "March", 4, "April", 5, "May", 6, "June", 7, "July", 8, "August", 9, "September", 10, "October", 11, "November", "December") &amp; " " &amp; TEXT(DAY(StartDate)) &amp; ", " &amp; TEXT(YEAR(StartDate))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
