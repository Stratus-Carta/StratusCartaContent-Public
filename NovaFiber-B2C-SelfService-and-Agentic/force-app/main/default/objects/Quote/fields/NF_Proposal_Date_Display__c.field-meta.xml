<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NF_Proposal_Date_Display__c</fullName>
    <label>NF Proposal Date (display)</label>
    <description>Today, written out, for document templates.</description>
    <formula>CASE(MONTH(TODAY()), 1, "January", 2, "February", 3, "March", 4, "April", 5, "May", 6, "June", 7, "July", 8, "August", 9, "September", 10, "October", 11, "November", "December") &amp; " " &amp; TEXT(DAY(TODAY())) &amp; ", " &amp; TEXT(YEAR(TODAY()))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
