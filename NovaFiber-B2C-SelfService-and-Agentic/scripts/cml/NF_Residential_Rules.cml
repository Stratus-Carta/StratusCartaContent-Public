// NF_Residential_Rules: generated by scripts/cml/nf_cml.py from NF_Residential_Rules.json. Edit the spec, not this file.
// One relation per component group; rules come from the spec.

type LineItem;

// NFR-INT-300
type NFFiber300 : LineItem {
    relation addons : NFGroup_addons[0..3];
    relation equipment : NFGroup_equipment[0..4];
    relation installation : NFGroup_installation[0..2];
    require(addons[NFStaticIp] > 0, addons[NFNovaShield], "A static IP makes your network reachable from the internet, so NovaShield Security is added.");
    message(addons[NFStaticIp] > 0, "NovaShield Security comes with a static IP: it guards a network that is reachable from the internet.", "Info");
}

// NFR-INT-1G
type NFFiber1G : LineItem {
    relation addons : NFGroup_addons[0..3];
    relation equipment : NFGroup_equipment[0..4];
    relation installation : NFGroup_installation[0..2];
    require(addons[NFStaticIp] > 0, addons[NFNovaShield], "A static IP makes your network reachable from the internet, so NovaShield Security is added.");
    message(addons[NFStaticIp] > 0, "NovaShield Security comes with a static IP: it guards a network that is reachable from the internet.", "Info");
}

// NFR-INT-2G
type NFFiber2G : LineItem {
    relation addons : NFGroup_addons[0..3];
    relation equipment : NFGroup_equipment[0..4];
    relation installation : NFGroup_installation[0..2];
    exclude(true, installation[NFSelfInstall], "NovaFiber 2 Gig needs a technician to certify the line, so self-install isn't available.");
    require(true, installation[NFProInstall], "Professional installation is included with NovaFiber 2 Gig.");
    require(addons[NFStaticIp] > 0, addons[NFNovaShield], "A static IP makes your network reachable from the internet, so NovaShield Security is added.");
    message(addons[NFStaticIp] > 0, "NovaShield Security comes with a static IP: it guards a network that is reachable from the internet.", "Info");
    message(equipment[NFMeshExtender] == 0, "Tip: add a Wi-Fi mesh extender to get 2 Gig speeds in every room.", "Info");
}

// NFR-TV-ESS
type NFTVEssentials : LineItem {
    relation channelPacks : NFGroup_channelPacks[0..2];
    relation equipment : NFGroup_equipment4[0..4];
    message(channelPacks[NFMoviesPack] > 0 && channelPacks[NFSportsPack] > 0, "With both packs, NovaTV Premium gives you more channels for about the same price.", "Info");
}

type NFGroup_addons : LineItem {}
type NF_NFR_ADD_CARE : NFGroup_addons {}   // NFR-ADD-CARE
type NFNovaShield : NFGroup_addons {}   // NFR-ADD-SEC
type NFStaticIp : NFGroup_addons {}   // NFR-ADD-SIP
type NFGroup_equipment : LineItem {}
type NFMeshExtender : NFGroup_equipment {}   // NFR-EQ-MESH
type NF_NFR_EQ_RTR : NFGroup_equipment {}   // NFR-EQ-RTR
type NFGroup_installation : LineItem {}
type NFProInstall : NFGroup_installation {}   // NFR-INS-PRO
type NFSelfInstall : NFGroup_installation {}   // NFR-INS-SELF
type NFGroup_channelPacks : LineItem {}
type NFMoviesPack : NFGroup_channelPacks {}   // NFR-TV-MOVIE
type NFSportsPack : NFGroup_channelPacks {}   // NFR-TV-SPORT
type NFGroup_equipment4 : LineItem {}
type NF_NFR_EQ_STB : NFGroup_equipment4 {}   // NFR-EQ-STB
